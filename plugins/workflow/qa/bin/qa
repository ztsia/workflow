#!/usr/bin/env bash
# qa — the qa CLI from wherever the plugin is installed: `qa <command> [args…]`.
# Commands are listed by `qa help`; the engine is scripts/qa.mjs (Node stdlib + playwright-core).
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  [[ "$link" == /* ]] && self="$link" || self="$(dirname "$self")/$link"
done
root="$(cd -P "$(dirname "$self")/.." && pwd)"

exec node "$root/scripts/qa.mjs" "$@"
